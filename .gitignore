**/bin/
**/obj/
.tools/
artifacts/
*.user
.vs/
.DS_Store
# macOS build output (the assembled .app and publish artifacts)
dist/
publish/

# Radio data section (data/): raw downloads are disposable caches,
# auto-regenerated by the build scripts — the real station data lives in
# canonical/*.csv + output/*.xlsx which ARE pushed to the repo.
data/raw/
data/.venv/
# app_catalog.write_app_catalog's temp file (mkstemp '.app-catalog.json.<random>.tmp'),
# left only if the process is killed between the write and the rename
data/output/.*.tmp
# check_stations.py's generated health report: a transient, timestamped snapshot
# (and it embeds absolute local paths) — not a checked-in catalog artifact
data/output/health-report.json

# Python bytecode caches
__pycache__/
*.pyc

# Claude Code local/personal overrides and agent worktrees (never committed)
.claude/worktrees/
.claude/settings.local.json
CLAUDE.local.md
