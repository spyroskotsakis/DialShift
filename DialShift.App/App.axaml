<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DialShift.App.App"
             Name="DialShift"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DialShift/Views/Theme/DialShiftTheme.axaml" />
  </Application.Styles>
</Application>
