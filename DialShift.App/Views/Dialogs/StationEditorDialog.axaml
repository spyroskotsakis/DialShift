<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DialShift.App.ViewModels"
        x:Class="DialShift.App.Views.Dialogs.StationEditorDialog"
        x:DataType="vm:StationEditorViewModel"
        Title="{Binding Title, StringFormat='{}{0} · DialShift'}"
        Width="680" MinWidth="620" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False">
  <!--
    Station editor (BHV-52/53). Add mode adds the station catalog (brief 3, docs/catalog-contracts.md §5.5): the search box,
    five filters and the status line on top; below them the manual form on the left and the detail pane on the right. The
    results overlay floats over the form column only, so the detail pane stays visible while the pointer or the arrow keys
    walk the results, and opening or closing it never changes the window's height. Edit mode is the plain form.
  -->
  <Window.Styles>
    <!-- The no-match message on the status line reads a step brighter than the plain status (D87). -->
    <Style Selector="TextBlock.hint.noMatch">
      <Setter Property="Foreground" Value="{StaticResource DsSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.filterLabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource DsSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <!-- While the pickers are disabled (loading, no catalog) their labels step down to the hint ink, still 5.86:1 on the
         window (D45, D89). -->
    <Style Selector="TextBlock.filterLabel:disabled">
      <Setter Property="Foreground" Value="{StaticResource DsSubtleBrush}"/>
    </Style>
    <!-- A value that does not fit ends in an ellipsis (D44), in the closed picker and in the drop-down alike (the item
         template is also the selection box's); the tooltip has the whole value. -->
    <Style Selector="ComboBox.filter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="vm:CatalogFilterOption">
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
        </DataTemplate>
      </Setter>
    </Style>
    <!-- A filter picker is about 100 px wide, so its drop-down may grow to 280 px to show a city or genre name (D83). -->
    <Style Selector="ComboBox.filter /template/ Popup#PART_Popup">
      <Setter Property="MaxWidth" Value="280"/>
    </Style>

    <!-- The results overlay: a raised card over the form column. -->
    <Style Selector="Border.catalogOverlay">
      <Setter Property="Background" Value="{StaticResource DsCardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DsInputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="BoxShadow" Value="{StaticResource DsOverlayShadow}"/>
    </Style>
    <Style Selector="ListBox#ResultsList">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Rows never take focus: typing stays in the search box while the arrow keys or the pointer walk the list. The right
         padding reserves the overlay's scroll bar at its expanded width (16 px, under the pointer), so no text, the
         frequency included, ever sits under it (D89). -->
    <Style Selector="ListBox#ResultsList ListBoxItem" x:DataType="vm:CatalogResultRow">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Padding" Value="8,5,20,5"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
    </Style>
    <Style Selector="TextBlock.resultTitle">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.resultKind">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource DsSubtleBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <!-- One highlight, however it is reached: the pointer highlights the row it moves over, so Fluent's lighter
         selected + pointer-over (#3A4E45) and selected + pressed fills are replaced by the keyboard highlight (#30413A),
         where every text keeps 4.5:1 (QG-03). A row the pointer rests on after the keyboard moved on keeps Fluent's darker
         hover (#2A393C). -->
    <Style Selector="ListBox#ResultsList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
    </Style>
    <!-- On any row fill the subtle ink falls under 4.5:1 (3.55:1 on the highlight, 3.94:1 on the hover): line 2 switches to
         the secondary ink there (4.76:1, 5.29:1), and line 1's separator always uses the muted ink (5.02:1 on the highlight;
         the dot is too small for its antialiased pixels to reach the secondary ink's 4.76:1), D85. -->
    <Style Selector="ListBox#ResultsList ListBoxItem:selected TextBlock.resultKind, ListBox#ResultsList ListBoxItem:pointerover TextBlock.resultKind, ListBox#ResultsList ListBoxItem:pressed TextBlock.resultKind">
      <Setter Property="Foreground" Value="{StaticResource DsSecondaryBrush}"/>
    </Style>
    <!-- The frequency column: never trimmed, so the place after the name gives way first. -->
    <Style Selector="TextBlock.resultFrequency">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource DsAccentBrush}"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.tile.small">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.tile.small TextBlock">
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <!-- A loaded logo sits on the light palette ink, so a dark or transparent logo stays visible on the dark card. -->
    <Style Selector="Border.tile.hasLogo">
      <Setter Property="Background" Value="{StaticResource DsTextBrush}"/>
      <Setter Property="Padding" Value="2"/>
    </Style>

    <!-- Quick play: a small icon button on the rows the pointer or the keyboard is on, and one that stays in the detail
         pane's top-right corner while it shows a station. No icon font: the glyph is inline PathIcon geometry in the app's
         own inks (the secondary one at rest, the accent one on the pointer and while that stream is the one playing).
         Both are pointed at and pressed, never tabbed to: the dialog's tab cycle is the search box, the filters and the
         form's own fields and buttons (§5.5), and the results list and the detail pane never take focus (D85). -->
    <Style Selector="Button.preview">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.preview PathIcon">
      <Setter Property="Foreground" Value="{StaticResource DsSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.preview:pointerover PathIcon, Button.preview.playing PathIcon">
      <Setter Property="Foreground" Value="{StaticResource DsAccentBrush}"/>
    </Style>
    <Style Selector="Button.preview:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DsTileBrush}"/>
    </Style>
    <!-- A row's play button sits left of the frequency column, clear of the scroll bar under it. -->
    <Style Selector="Button.preview.inRow">
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- The footer's "Show more": a compact text control, so the footer and its count text keep their height. A resting
         border keeps it reading as a control, not as the static count text beside it (QG-03). -->
    <Style Selector="Button.showMore">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource DsSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DsInputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.showMore:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource DsAccentBrush}"/>
    </Style>

    <!-- Detail pane -->
    <Style Selector="Border.detail">
      <Setter Property="Background" Value="{StaticResource DsCardBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- Catalog names reach 399 characters: three lines, then an ellipsis (the tooltip has the whole name). -->
    <Style Selector="TextBlock.detailName">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxLines" Value="3"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource DsTileBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Logo, else the monogram (the station tiles' rule, D66); the frequency in its own column on the right (D85). -->
    <DataTemplate x:Key="CatalogResult" x:DataType="vm:CatalogResultRow">
      <DockPanel>
        <Border DockPanel.Dock="Left" Classes="tile small" Classes.hasLogo="{Binding Logo, Converter={x:Static ObjectConverters.IsNotNull}}"
                ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">
          <Panel>
            <TextBlock Text="{Binding Monogram}" IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}" />
            <Image Source="{Binding Logo}" IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNotNull}}" Stretch="Uniform" />
          </Panel>
        </Border>
        <TextBlock DockPanel.Dock="Right" Classes="resultFrequency" Text="{Binding FrequencyText}"
                   IsVisible="{Binding FrequencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- Quick play: shown on the row the pointer or the keyboard is on, and on the row being previewed, so its stop
             stays reachable; it sits left of the frequency column, clear of the scroll bar. The fixed-width slot holds the
             button's place whether it shows or not, so the title's width is constant and hovering a row never re-trims it.
             The stop glyph is a touch smaller than the play one so the two states weigh the same (the play path renders
             wider than its box; the stop square stretches to fill it). -->
        <Panel DockPanel.Dock="Right" Width="34" VerticalAlignment="Center">
          <Button Classes="preview inRow" Classes.playing="{Binding IsPreviewing}" HorizontalAlignment="Right"
                  IsVisible="{Binding ShowPreview}" Command="{Binding PreviewCommand}"
                  AutomationProperties.Name="{Binding PreviewAutomationName}" ToolTip.Tip="{Binding PreviewAutomationName}">
            <Panel>
              <PathIcon Data="M8,5v14l11,-7z" Width="16" Height="16" IsVisible="{Binding ShowPlayIcon}" />
              <PathIcon Data="M6,6h12v12H6z" Width="12" Height="12" IsVisible="{Binding IsPreviewing}" />
            </Panel>
          </Button>
        </Panel>
        <StackPanel VerticalAlignment="Center">
          <!-- The Runs sit on one line with no whitespace between them: a line break between inline elements would add a
               " " run on each side of the dot ("Name  ·  Place"). -->
          <TextBlock Classes="resultTitle"><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource DsMutedBrush}" /><Run Text="{Binding Place}" FontSize="12" Foreground="{StaticResource DsSecondaryBrush}" /></TextBlock>
          <!-- The VPN badge shares line 2 with the kind, so a flagged row stays two lines tall like the rest. -->
          <DockPanel>
            <Border DockPanel.Dock="Right" Classes="vpnBadge" Margin="8,2,0,0" IsVisible="{Binding HasVpn}">
              <TextBlock Text="{Binding VpnText}" />
            </Border>
            <TextBlock Classes="resultKind" Text="{Binding Kind}"
                       IsVisible="{Binding Kind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </DockPanel>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="26,24" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Classes="pageTitle" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Description}" Margin="0,8,0,0" />
    </StackPanel>

    <!-- Catalog: search, filters, status (Add mode only). -->
    <StackPanel Grid.Row="1" IsVisible="{Binding IsAddMode}" Margin="0,0,0,14">
      <TextBox x:Name="SearchBox" Text="{Binding SearchText}" TabIndex="0" Margin="0,0,0,10"
               PlaceholderText="{x:Static vm:UiText.SearchPlaceholder}"
               AutomationProperties.Name="Search stations">
        <TextBox.IsEnabled>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="IsCatalogLoading" />
            <Binding Path="IsCatalogAvailable" />
          </MultiBinding>
        </TextBox.IsEnabled>
      </TextBox>
      <Grid x:Name="FilterRow" ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="8" IsEnabled="{Binding IsCatalogAvailable}">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="filterLabel" Text="Country" />
          <ComboBox Classes="filter" TabIndex="1" ItemsSource="{Binding CountryOptions}" SelectedItem="{Binding SelectedCountry}"
                    AutomationProperties.Name="Country filter" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="filterLabel" Text="City" />
          <ComboBox Classes="filter" TabIndex="2" ItemsSource="{Binding CityOptions}" SelectedItem="{Binding SelectedCity}"
                    AutomationProperties.Name="City filter" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="filterLabel" Text="Type" />
          <ComboBox Classes="filter" TabIndex="3" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                    AutomationProperties.Name="Type filter" />
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Classes="filterLabel" Text="Genre" />
          <ComboBox Classes="filter" TabIndex="4" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre}"
                    AutomationProperties.Name="Genre filter" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Classes="filterLabel" Text="Language" />
          <ComboBox Classes="filter" TabIndex="5" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                    AutomationProperties.Name="Language filter" />
        </StackPanel>
        <Button Grid.Column="5" Content="Clear" TabIndex="6" MinWidth="76" MinHeight="36" Padding="14,8" VerticalAlignment="Bottom"
                Command="{Binding ClearFiltersCommand}"
                AutomationProperties.Name="Clear search and filters" ToolTip.Tip="Clear search and filters" />
      </Grid>
      <!-- A text block's automation peer announces its text and ignores AutomationProperties.Name, so the name sits on a
           container exposed to the control view: "Catalog status", with the line as its help text. The text block inside is
           a polite live region, so the loading → loaded (or unavailable) change and the no-match message are announced.
           With no match the results stay closed and the message shows here, above the form it points to (D87). -->
      <Border Margin="0,8,0,0"
              AutomationProperties.Name="Catalog status" AutomationProperties.HelpText="{Binding StatusLineText}"
              AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
        <TextBlock Classes="hint" Classes.noMatch="{Binding HasNoMatches}" Text="{Binding StatusLineText}" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </StackPanel>

    <!-- The form column (separator, fields, hint) and, in Add mode, the detail pane beside it; the results overlay covers
         the form column. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <StackPanel x:Name="FormColumn" Grid.Column="0">
        <!-- Shown with the search box (while the catalog loads or once it is available): without a catalog there is nothing
             to choose "or" from. -->
        <Grid ColumnDefinitions="*,Auto,*" Margin="0,2,0,12">
          <Grid.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsAddMode" />
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="IsCatalogLoading" />
                <Binding Path="IsCatalogAvailable" />
              </MultiBinding>
            </MultiBinding>
          </Grid.IsVisible>
          <Border Height="1" Background="{StaticResource DsDialRingBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="hint" Text="{x:Static vm:UiText.ManualEntrySeparator}" Margin="10,0" />
          <Border Grid.Column="2" Height="1" Background="{StaticResource DsDialRingBrush}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Classes="fieldLabel" Text="{x:Static vm:StationEditorViewModel.NameLabel}" />
        <TextBox x:Name="NameField" Text="{Binding Name}" TabIndex="7" MaxLength="{x:Static vm:StationEditorViewModel.NameMaxLength}"
                 AutomationProperties.Name="{x:Static vm:StationEditorViewModel.NameLabel}" />
        <TextBlock Classes="fieldLabel" Text="{x:Static vm:StationEditorViewModel.TagLabel}" />
        <TextBox x:Name="TagField" Text="{Binding Tag}" TabIndex="8" MaxLength="{x:Static vm:StationEditorViewModel.TagMaxLength}" PlaceholderText="Internet radio"
                 AutomationProperties.Name="{x:Static vm:StationEditorViewModel.TagLabel}" />
        <TextBlock Classes="fieldLabel" Text="{x:Static vm:StationEditorViewModel.UrlLabel}" />
        <TextBox x:Name="UrlField" Text="{Binding Url}" TabIndex="9" MaxLength="{x:Static vm:StationEditorViewModel.UrlMaxLength}"
                 AutomationProperties.Name="{x:Static vm:StationEditorViewModel.UrlLabel}" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Hint}" />
      </StackPanel>

      <!-- Detail pane: exactly as tall as the form column, long notes (or a long name) scroll instead of growing the window. -->
      <Border Grid.Column="1" Classes="detail" Width="236" Margin="16,0,0,0" VerticalAlignment="Top" ClipToBounds="True"
              Height="{Binding #FormColumn.Bounds.Height}"
              AutomationProperties.Name="Station details"
              AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="IsCatalogLoading" />
            <Binding Path="IsCatalogAvailable" />
          </MultiBinding>
        </Border.IsVisible>
        <Panel>
          <TextBlock Classes="hint" Text="{Binding DetailPlaceholder}" VerticalAlignment="Center" TextAlignment="Center"
                     IsVisible="{Binding DetailRow, Converter={x:Static ObjectConverters.IsNull}}" />
          <DockPanel IsVisible="{Binding DetailRow, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Quick play for the station the pane shows, in the pane's top-right corner, for as long as it shows one. -->
            <Button DockPanel.Dock="Top" Classes="preview" HorizontalAlignment="Right" Margin="0,0,0,8"
                    Classes.playing="{Binding DetailRow.IsPreviewing}" Command="{Binding DetailRow.PreviewCommand}"
                    AutomationProperties.Name="{Binding DetailRow.PreviewAutomationName}"
                    ToolTip.Tip="{Binding DetailRow.PreviewAutomationName}">
              <Panel>
                <PathIcon Data="M8,5v14l11,-7z" Width="16" Height="16" IsVisible="{Binding DetailRow.ShowPlayIcon}" />
                <PathIcon Data="M6,6h12v12H6z" Width="12" Height="12" IsVisible="{Binding DetailRow.IsPreviewing}" />
              </Panel>
            </Button>
            <!-- Page Down / Page Up in the search box scroll it. The margin keeps the text clear of the scroll bar even when the
                 pointer expands it to its full width over the content (P9). -->
            <ScrollViewer x:Name="DetailScroll" Focusable="False">
              <StackPanel Margin="0,0,20,0">
                <DockPanel Margin="0,0,0,10">
                  <Border DockPanel.Dock="Left" Classes="tile" Classes.hasLogo="{Binding DetailLogo, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Panel>
                      <TextBlock Text="{Binding DetailRow.Monogram}" IsVisible="{Binding DetailLogo, Converter={x:Static ObjectConverters.IsNull}}" />
                      <Image Source="{Binding DetailLogo}" IsVisible="{Binding DetailLogo, Converter={x:Static ObjectConverters.IsNotNull}}" Stretch="Uniform" />
                    </Panel>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="detailName" Text="{Binding DetailRow.Name}" ToolTip.Tip="{Binding DetailRow.Name}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Classes="secondary" Text="{Binding DetailRow.Location}" Margin="0,2,0,0"
                               IsVisible="{Binding DetailRow.Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,0,0,4">
                  <!-- The VPN badge leads the chips, so a geo-restricted stream is the first thing the detail pane says. -->
                  <Border Classes="vpnBadge" Margin="0,0,6,6" IsVisible="{Binding DetailRow.HasVpn}">
                    <TextBlock Text="{Binding DetailRow.VpnText}" />
                  </Border>
                  <Border Classes="chip" IsVisible="{Binding DetailRow.FrequencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding DetailRow.FrequencyText}" />
                  </Border>
                  <Border Classes="chip" IsVisible="{Binding DetailRow.Kind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding DetailRow.Kind}" />
                  </Border>
                  <Border Classes="chip" IsVisible="{Binding DetailRow.LanguageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding DetailRow.LanguageText}" />
                  </Border>
                  <Border Classes="chip" IsVisible="{Binding DetailRow.VotesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding DetailRow.VotesText}" />
                  </Border>
                </WrapPanel>
                <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailRow.Notes}" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </Border>

      <!-- Results overlay (D63, D83, D85): exactly as tall as the form column, under the status line, so it always covers
           the whole form and opening it never resizes the window (§5.5). The list fills the card from the top; the footer
           stays at the card's bottom. -->
      <Border x:Name="ResultsOverlay" Grid.Column="0" Classes="catalogOverlay" VerticalAlignment="Top" ZIndex="1"
              Height="{Binding #FormColumn.Bounds.Height}" IsVisible="{Binding IsResultsOpen}">
        <DockPanel>
          <!-- The rule above the footer marks a half-visible last row as scrolled content, not a cut one. -->
          <Border x:Name="ResultsFooter" DockPanel.Dock="Bottom" BorderBrush="{StaticResource DsDialRingBrush}" BorderThickness="0,1,0,0" Margin="6,2,6,0" Padding="4,6,4,4"
                  IsVisible="{Binding TotalCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <DockPanel>
              <!-- The next page of the same query, appended to the list already shown; gone once all the matches are. It is
                   not a Tab stop (the documented Tab order ends at the form), so keyboard users reach it with Ctrl+Down. -->
              <Button DockPanel.Dock="Right" Classes="showMore" MinWidth="72" Margin="8,0,0,0" Focusable="False"
                      Content="{x:Static vm:UiText.ShowMore}" IsVisible="{Binding HasMoreResults}"
                      Command="{Binding ShowMoreCommand}" AutomationProperties.Name="{x:Static vm:UiText.ShowMoreAutomationName}"
                      ToolTip.Tip="{x:Static vm:UiText.ShowMore}" />
              <TextBlock Classes="hint" Text="{Binding TotalCountText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
          </Border>
          <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding HighlightedResult}"
                   ItemTemplate="{StaticResource CatalogResult}" VerticalAlignment="Top" Focusable="False"
                   AutomationProperties.Name="Station catalog results" />
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="0,4,0,0" />

    <DockPanel Grid.Row="4" Margin="0,18,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Classes="accent" Content="Save" IsDefault="True" MinWidth="88" TabIndex="10"
              Command="{Binding SaveCommand}" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" TabIndex="11"
              Command="{Binding CancelCommand}" />
      <Button DockPanel.Dock="Left" Classes="danger" MinWidth="144" Content="{Binding DeleteLabel}" TabIndex="12"
              Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
    </DockPanel>
  </Grid>
</Window>
