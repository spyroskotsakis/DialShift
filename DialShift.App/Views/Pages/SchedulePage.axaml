<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DialShift.App.ViewModels"
             x:Class="DialShift.App.Views.Pages.SchedulePage"
             x:DataType="vm:SchedulePageViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.slotTime">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource DsSubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.slotTime.on">
      <Setter Property="Foreground" Value="{StaticResource DsAccentBrush}" />
    </Style>
    <Style Selector="Border.zoneTag">
      <Setter Property="Background" Value="{StaticResource DsTileBrush}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Border.zoneTag TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource DsTextBrush}" />
    </Style>
    <Style Selector="Border.zoneTag.unknown">
      <Setter Property="Background" Value="{StaticResource DsWarningTintBrush}" />
    </Style>
    <Style Selector="Border.zoneTag.unknown TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DsWarningBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Classes="accent" MinWidth="160" Content="+  Add time slot" Command="{Binding AddCommand}" />
      <CheckBox Content="Follow my schedule" IsChecked="{Binding IsScheduleEnabled}" VerticalAlignment="Center" />
    </DockPanel>

    <ItemsControl ItemsSource="{Binding DayTabs}" Margin="-4,0,-4,15">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DayTabViewModel">
          <Button Classes="tab" Classes.selected="{Binding IsSelected}"
                  Content="{Binding Label}" Command="{Binding SelectCommand}"
                  HorizontalAlignment="Stretch" Margin="4,0"
                  AutomationProperties.Name="{Binding AutomationName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ItemsControl ItemsSource="{Binding Slots}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SlotRowViewModel">
          <Border Classes="card">
            <DockPanel>
              <Button DockPanel.Dock="Right" MinWidth="72" Content="Edit" Command="{Binding EditCommand}"
                      AutomationProperties.Name="{Binding EditAutomationName}" />
              <TextBlock DockPanel.Dock="Left" Classes="slotTime" Classes.on="{Binding IsEnabled}" Text="{Binding Time}" />
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Classes="rowTitle" Text="{Binding StationName}" />
                <TextBlock Classes="secondary" Text="{Binding Subtitle}" Margin="0,4,0,0" />
                <!-- QA-N6: the zone and the next start on this computer, which can fall on another day than the tab. -->
                <WrapPanel IsVisible="{Binding HasZone}" Margin="0,6,0,0">
                  <Border Classes="zoneTag" Classes.unknown="{Binding IsZoneUnknown}" Margin="0,0,8,2" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding ZoneToolTip}">
                    <TextBlock Text="{Binding ZoneText}" />
                  </Border>
                  <TextBlock Classes="secondary" Classes.warning="{Binding IsZoneUnknown}" Text="{Binding NextStartText}"
                             VerticalAlignment="Center" Margin="0,0,0,2" />
                </WrapPanel>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="card" Padding="24" IsVisible="{Binding IsEmpty}">
      <StackPanel>
        <TextBlock Text="{Binding EmptyTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding EmptyText}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <TextBlock Classes="hint" Text="{Binding HelperText}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
