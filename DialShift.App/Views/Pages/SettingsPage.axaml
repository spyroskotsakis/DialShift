<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DialShift.App.ViewModels"
             x:Class="DialShift.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <StackPanel>
    <Border Classes="card" Padding="18,5" Margin="0,0,0,6">
      <StackPanel>
        <TextBlock Classes="cardTitle" Text="At your service" />
        <CheckBox Margin="0,6,0,0"
                  Content="{Binding LaunchAtLoginLabel}"
                  IsChecked="{Binding LaunchAtLogin}"
                  IsEnabled="{Binding IsStartupEditable}" />
        <TextBlock Classes="error" Text="{Binding StartupDiagnostic}" IsVisible="{Binding HasStartupDiagnostic}"
                   Margin="28,0,0,4" />
        <CheckBox Content="{Binding StartInTrayLabel}" IsChecked="{Binding StartInTray}" />
        <TextBlock Classes="secondary" Text="{Binding StartupHelp}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="18,5" Margin="0,0,0,6">
      <StackPanel>
        <TextBlock Classes="cardTitle" Text="Keep the music going" />
        <TextBlock Classes="secondary" Text="{Binding FallbackHelp}" Margin="0,4,0,5" />
        <ComboBox ItemsSource="{Binding FallbackOptions}" SelectedItem="{Binding SelectedFallback}"
                  MinWidth="280" MaxWidth="380" HorizontalAlignment="Left"
                  AutomationProperties.Name="Fallback station">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FallbackOption">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="vpnBadge" Margin="8,0,0,0" IsVisible="{Binding HasVpn}">
                  <TextBlock Text="{Binding VpnText}" />
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="18,5">
      <StackPanel>
        <TextBlock Text="{Binding VersionText}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Classes="secondary" FontSize="13" Text="{Binding Tagline}" Margin="0,2,0,4" />
        <Button MinWidth="264" Content="Open settings folder ↗" Command="{Binding OpenSettingsFolderCommand}" HorizontalAlignment="Left" Padding="16,5" />
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" Margin="0,0,0,0">
          <Button MinWidth="264"
                  Content="{Binding ExportStationsLabel}" Command="{Binding ExportStationsCommand}"
                  IsEnabled="{Binding IsTransferEnabled}"
                  AutomationProperties.Name="Export stations &amp; schedule"
                  Padding="16,5" />
          <Button MinWidth="264"
                  Content="{Binding ImportStationsLabel}" Command="{Binding ImportStationsCommand}"
                  IsEnabled="{Binding IsTransferEnabled}"
                  AutomationProperties.Name="Import stations &amp; schedule"
                  Padding="16,5" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
