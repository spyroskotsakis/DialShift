<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DialShift.App.ViewModels"
             x:Class="DialShift.App.Views.Pages.StationsPage"
             x:DataType="vm:StationsPageViewModel">
  <StackPanel>
    <DockPanel Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Classes="accent" Content="+  Add station" Command="{Binding AddCommand}" />
      <TextBlock Classes="eyebrow" Text="{Binding CountText}" VerticalAlignment="Center" />
    </DockPanel>

    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StationRowViewModel">
          <Border Classes="card" Classes.current="{Binding IsCurrent}">
            <Grid ColumnDefinitions="60,*,Auto">
              <Border Classes="tile" Classes.current="{Binding IsCurrent}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Initial}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Classes="rowTitle" Text="{Binding Name}" />
                <TextBlock Classes="secondary" Text="{Binding Subtitle}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="▶  Listen" Command="{Binding ListenCommand}"
                        AutomationProperties.Name="{Binding ListenAutomationName}" />
                <Button Content="Edit" Command="{Binding EditCommand}"
                        AutomationProperties.Name="{Binding EditAutomationName}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="card" IsVisible="{Binding IsEmpty}">
      <TextBlock Text="{Binding EmptyText}" FontSize="16" TextWrapping="Wrap" />
    </Border>

    <TextBlock Classes="hint" Text="{Binding CreditText}" Margin="0,6,0,8" />
  </StackPanel>
</UserControl>
