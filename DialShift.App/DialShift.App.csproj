<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release artifacts (decision D13): Windows x64 + native Apple Silicon. No osx-x64. -->
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>DialShift</AssemblyName>
    <RootNamespace>DialShift.App</RootNamespace>
    <RollForward>Major</RollForward>
    <Version>0.5.0</Version>
    <ApplicationIcon>Assets\dialshift.ico</ApplicationIcon>
    <!-- [LibraryImport] stubs and [UnmanagedCallersOnly] function pointers in Interop/ (macOS AVPlayer adapter, NSWorkspace wake observer). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ship only the x64 VLC runtime in the win-x64 package (D13). -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <!-- Platform/MacOS/MacRenderTimerFallback.cs needs AvaloniaLocator, RenderLoop and SleepLoopRenderTimer, which
         Avalonia 12 marks [PrivateApi] and leaves out of its reference assemblies. The opt-in compiles against the real
         assemblies; it is safe only because every Avalonia package is pinned to one exact version (D6, PK-06), and the
         fallback must be re-verified on any Avalonia bump. AVA3001 is the opt-in's own reminder of that. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVA3001</MSBuildWarningsAsMessages>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <!-- Compile-time reference stays unconditional so IDE builds without a RID compile (brief 1 §7.2). -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
  </ItemGroup>

  <!-- The VLC native runtime ships only in the Windows artifact; macOS uses AVPlayer. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DialShift.Core\DialShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test seam: the headless suites drive App.Run, StartupFailure and App.Tray directly instead of through reflection. -->
    <InternalsVisibleTo Include="DialShift.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brief 3: the generated station catalog (data/output/app-catalog.json), a loose file next to the apphost (D59, D60). -->
    <Content Include="..\data\output\app-catalog.json" Link="app-catalog.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\data\output\app-catalog.json')" />
  </ItemGroup>
</Project>
