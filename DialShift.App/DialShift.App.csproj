<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release artifacts (decision D2): Windows x64 + native Apple Silicon. No osx-x64. -->
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>DialShift</AssemblyName>
    <RootNamespace>DialShift.App</RootNamespace>
    <RollForward>Major</RollForward>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <!-- Compile-time reference stays unconditional so IDE builds without a RID compile (brief 1 §7.2). -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
  </ItemGroup>

  <!-- The VLC native runtime ships only in the Windows artifact; macOS uses AVPlayer. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DialShift.Core\DialShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
