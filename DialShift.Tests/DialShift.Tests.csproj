<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DialShift.Core\DialShift.Core.csproj"/>
    <!-- Headless integration tests of the App's platform layer (CT-SI, CT-LOG, HS-*). Built without a RID, like CI;
         OS-specific types are reached only behind OperatingSystem guards. -->
    <ProjectReference Include="..\DialShift.App\DialShift.App.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <!-- Headless UI suites (HS-01..08, HS-13, HS-14): the real views and dialogs on Avalonia's headless platform with the
         Skia renderer, driven from the console runner. Pinned to the App's Avalonia version (D6, PK-06). -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.2"/>
  </ItemGroup>
</Project>
